SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DATABASE_URL=sqlite:///./data/medical_chat.db
LOG_LEVEL=INFO
LOG_FILE=./logs/medical_chat.log

# Use mock for local development and tests; switch to bedrock for AWS.
LLM_PROVIDER=mock
LLM_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000

MAX_RETRIES=3
RETRY_DELAY=2
MAX_CONCURRENCY=5
SHUTDOWN_GRACE_PERIOD=15

AWS_REGION=us-east-1
# AWS_BEDROCK_ENDPOINT_URL=

# Mock-provider development controls.
MOCK_RESPONSE_DELAY=0.1
MOCK_FAILURES_BEFORE_SUCCESS=0

# Used by the Streamlit container/application.
BACKEND_URL=http://localhost:8000
POLL_INTERVAL=1

